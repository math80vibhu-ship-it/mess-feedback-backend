      <td>admin</td>
      <td><code style="color: #b91c1c;">adminSecurePassword123!</code></td>
      <td><code>$2b$10$nsfa0Y03amAt.1r3gdAGnOidnqc9A/WMBXQRgD7XLn4NHk7SPKAre</code></td>
    </tr>
    <tr>
      <td>Dining Hall Supervisor</td>
      <td><code>supervisor@hostel.edu</code></td>
      <td>supervisor</td>
      <td><code style="color: #b91c1c;">supervisorPass2026#</code></td>
      <td><code>$2b$10$KrrE4S.NU9cLnqHG7D1tTeheVP0nkcLK/75FwdtqHgj04WCpuAEda</code></td>
    </tr>
