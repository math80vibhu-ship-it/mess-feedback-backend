# HARDENED PRODUCTION DOCKERFILE
# Security hardening:
# 1. Minimal Alpine base image (strips bloated Linux utilities)
# 2. Non-root user execution (drops root privilege to prevent container breakout)
# 3. Dedicated HEALTHCHECK instruction
# 4. Production-only dependencies

FROM node:20-alpine

ENV NODE_ENV=production

WORKDIR /app

COPY package*.json ./

RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY --chown=node:node . .

# Dedicated container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/health || exit 1

# Drop root privileges and switch to non-root user
USER node

EXPOSE 5000

CMD ["node", "server.js"]
